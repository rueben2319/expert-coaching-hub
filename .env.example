# CORS Configuration (comma-separated list of allowed origins)
# For development: http://localhost:5173,http://localhost:8080
# For production: https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# Redis Configuration for Distributed Rate Limiting
# For Upstash Redis: https://your-upstash-url
# For local Redis: redis://localhost:6379
# Set REDIS_ENABLED=false to disable Redis and use in-memory fallback
REDIS_URL=
REDIS_ENABLED=true

# Supabase Project ID (for image optimization)
# Extracted from your Supabase project URL: https://[PROJECT_ID].supabase.co
VITE_SUPABASE_PROJECT_ID=

# Withdrawal Limits Configuration
# Copy this to your .env file and modify as needed

# Maximum withdrawal per transaction (default: 10,000 credits)
VITE_MAX_WITHDRAWAL=10000

# Minimum withdrawal amount (default: 10 credits)
VITE_MIN_WITHDRAWAL=10

# Maximum daily withdrawal (default: 50,000 credits)
VITE_DAILY_WITHDRAWAL_LIMIT=50000

# Credits must age this many days before withdrawal (default: 3 days)
VITE_CREDIT_AGING_DAYS=3

# Rate limit: requests per hour (default: 5)
VITE_RATE_LIMIT_PER_HOUR=5

# Credit to MWK conversion rate (default: 100)
VITE_CONVERSION_RATE=100
